.Rproj.user
.Rhistory
.RData
.Ruserdata
inst/doc
docs
/doc/
/Meta/
vignettes/*.html

# local STAC cube cache (generated by data-raw/vignette_data_break.R)
data-raw/.break_cache/

# terra sidecars regenerated when tests/benchmarks read inst/extdata rasters
inst/extdata/*.aux.xml

# bulky benchmark artifacts (data-raw/benchmark_filter_geom.R); summary.csv is
# committed as the evidence record, the raw curl logs and rasters are not
data-raw/logs/**/*.log
data-raw/logs/**/*.tif
data-raw/logs/**/*.rds
data-raw/logs/**/*.gpkg
data-raw/logs/benchmark_break_class/summary_patches.csv

# per-group temporal QA (data-raw/break_class_groups.R): the downloaded COGs,
# item JSON and the per-patch table are regenerated; the summary CSVs and rss.txt
# are the committed evidence record
data-raw/logs/**/*.json
data-raw/logs/break_class_groups/*/summary_patches.csv

# disturbance comparison (data-raw/disturbance_compare.R, #67): the per-patch join is one
# row per change patch (tens of thousands) and is regenerated by the script; the summary
# CSVs beside it are the committed evidence record.
data-raw/logs/disturbance_compare/*/summary_patch_join.csv
